---
import { getCollection } from "astro:content";
import TeamCard from "./TeamCard.astro";

const team = await getCollection("team");
---

<svg
  viewBox="0 0 98 99"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  width="0"
  height="0"
>
  <g fill="none">
    <defs>
      <clipPath
        id="petals"
        clipPathUnits="objectBoundingBox"
        transform="scale(0.01, 0.01)"
      >
        <path
          d="M83.8068 49.7349C116.649 87.1445 86.3213 117.472 48.9117 84.63C11.5021 117.472 -18.8258 87.1445 14.0166 49.7349C-18.8258 12.3253 11.5021 -18.0026 48.9117 14.8398C86.3213 -18.0026 116.649 12.3253 83.8068 49.7349Z"
          fill="#231F20"></path>
      </clipPath>
    </defs>
  </g>
</svg>

<section class="container" id="team">
  <header>
    <h2><span>Team</span></h2>
    <p>
      <button type="button" class="comment" aria-expanded="false">
        //<span class="todo">// TODO: remove digit #2 = 7</span>
      </button>
      Check these superheroes
    </p>
  </header>
  <ul>
    {
      team.map((member, i) => (
        <li>
          <TeamCard member={member} index={i} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  ul {
    display: grid;
    gap: var(--sp-l);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    margin-bottom: var(--sp-xl);
  }

  .comment {
    position: relative;
    font: inherit;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    color: var(--color-black);
    background-color: var(--color-primary);
    border: none;
    padding: 0 var(--sp-3xs);
    border-radius: 0.2em;
    cursor: help;
  }

  /* hidden code digit #2: a "forgotten" TODO comment */
  .todo {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0;
    z-index: 3;
    padding: 0.4em 0.7em;
    white-space: nowrap;
    font-size: var(--fs--1);
    color: var(--color-primary);
    background-color: var(--color-black);
    border-radius: var(--br-s);
    text-shadow: 0 0 0.4em var(--color-primary);
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    translate: 0 0.3rem;
    transition:
      opacity 0.2s ease,
      translate 0.2s ease,
      visibility 0s 0.2s;
  }

  .comment:is(:hover, :focus-visible, [aria-expanded="true"]) .todo {
    visibility: visible;
    opacity: 1;
    translate: 0;
    transition:
      opacity 0.2s ease,
      translate 0.2s ease;
    animation: glitch 0.4s steps(4);
  }

  @keyframes glitch {
    25% {
      text-shadow:
        -3px 0 #ff2a6d,
        3px 0 #05d9e8;
      clip-path: inset(0 0 50% 0);
    }
    50% {
      text-shadow:
        3px 0 #ff2a6d,
        -3px 0 #05d9e8;
      clip-path: inset(40% 0 0 0);
    }
  }

  /* staggered, slightly rotated grid on wider screens */
  @media (min-width: 45em) {
    ul {
      padding-bottom: var(--sp-l);
    }

    li {
      transition: rotate 0.3s ease;
    }

    li:nth-child(3n + 1) {
      rotate: -1.5deg;
    }

    li:nth-child(3n + 2) {
      rotate: 1deg;
      translate: 0 var(--sp-l);
    }

    li:nth-child(3n) {
      rotate: -0.5deg;
    }

    li:is(:hover, :focus-within) {
      rotate: 0deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    li,
    .todo,
    .comment:is(:hover, :focus-visible, [aria-expanded="true"]) .todo {
      transition: none;
      animation: none;
    }
  }
</style>

<script>
  // hidden code digit #2: tap the // comment (or read the console)
  const comment = document.querySelector("#team .comment");
  comment?.addEventListener("click", () => {
    const open = comment.getAttribute("aria-expanded") === "true";
    comment.setAttribute("aria-expanded", String(!open));
  });

  console.log(
    String.raw`%c
   ___ ___ _  __
  / __/ __| |/ /
 | (_| (__| ' <
  \___\___|_|\_\

 > 4 digits are hidden on this site.
 > digit #1: workshop images don't like being poked. try it 3 times.
 > digit #2: developers leave comments everywhere... even in the Team section //
 > enter the code at /code
`,
    "font-family: monospace; color: #B9FF66; background: #191A23; padding: 1em; line-height: 1.3;",
  );
</script>
