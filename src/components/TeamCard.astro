---
import { Image } from "astro:assets";

const { member, index = 0 } = Astro.props;
const { name, function: role, bio, pic } = member.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<article>
  <span class="index" aria-hidden="true">
    [{String(index + 1).padStart(2, "0")}]
  </span>
  <div class="picwrap">
    <div class="profilepic">
      <Image src={pic} width={300} height={300} alt={`Profile pic of ${name}`} />
    </div>
  </div>
  <p class="name"><a href={`${base}/team/${member.id}`}>{name}</a></p>
  <p class="function">{role}</p>
  <p class="bio">{bio}</p>
</article>

<style>
  article {
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    position: relative;
    background-color: var(--color-background);

    border: solid 2px var(--color-text);
    border-bottom-width: 8px;
    border-radius: var(--br-l);

    padding: var(--sp-m);

    text-align: left;

    display: grid;
    column-gap: var(--sp-m);
    grid-template-columns: 1fr 2fr;
    align-items: end;

    transition:
      translate 0.25s ease,
      box-shadow 0.25s ease;
  }

  article:is(:hover, :focus-within) {
    translate: -0.3rem -0.3rem;
    box-shadow: 0.6rem 0.6rem 0 var(--color-primary);
  }

  p {
    margin: 0;
  }

  .index {
    position: absolute;
    top: var(--sp-s);
    right: var(--sp-l);
    font-family: var(--mono);
    font-size: var(--fs--1);
    opacity: 0.5;
  }

  img {
    filter: grayscale(100%) brightness(110%);
    object-fit: cover;
    aspect-ratio: 1;
    display: block;
    transition: scale 0.4s ease;
  }

  .picwrap {
    grid-column: 1;
    grid-row: 1 / span 2;
    filter: drop-shadow(var(--color-text) 0.7rem 0.3rem);
    align-self: start;
    transition: rotate 0.6s ease;
  }

  .profilepic {
    clip-path: url(#petals);
    position: relative;
  }

  /* green tint, swapped for a generative dot grid on hover */
  .profilepic::after {
    content: "";
    display: block;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;

    background-color: var(--color-primary);
    background-image: radial-gradient(
      var(--color-black) 18%,
      transparent 20%
    );
    background-size: 0 0;
    mix-blend-mode: multiply;
    transition: background-size 0.4s ease;
  }

  article:is(:hover, :focus-within) {
    & .picwrap {
      rotate: 45deg;
    }

    & img {
      scale: 1.15;
      rotate: -45deg;
    }

    & .profilepic::after {
      background-size: 0.7rem 0.7rem;
    }
  }

  .name {
    font-weight: bolder;
    font-size: var(--fs-1);
    grid-row: 1;
    grid-column: 2;
  }

  /* whole card is clickable */
  .name a::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: var(--br-l);
  }

  .function {
    grid-row: 2;
    grid-column: 2;
    font-family: var(--mono);
    font-size: var(--fs--1);
  }

  .function::before {
    content: "// ";
    color: var(--color-black);
    background-color: var(--color-primary);
    border-radius: 0.2em;
    padding: 0 0.2em;
    margin-right: 0.3em;
  }

  .bio {
    grid-row: 3;
    grid-column: 1 / span 2;

    margin-top: var(--sp-m);
    padding-top: var(--sp-m);
    border-top: dashed 1px var(--color-text);
  }

  @media screen and (min-width: 45em) {
    article {
      padding: var(--sp-l);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    article,
    img,
    .picwrap,
    .profilepic::after {
      transition: none;
    }

    article:is(:hover, :focus-within) {
      translate: none;

      & .picwrap,
      & img {
        rotate: none;
        scale: none;
      }
    }
  }
</style>
