---
import Code from "../components/Code.astro";
import Base from "../layouts/Base.astro";
---

<Base title="Code">
  <section class="container">
    <div class="terminal">
      <div class="bar" aria-hidden="true">
        <span></span><span></span><span></span>
        <p>cck@vault: ~/secret</p>
      </div>

      <div class="screen">
        <h1 class="visually-hidden">Crack the code</h1>
        <p class="line">&gt; 4 digits are hidden across this website.</p>
        <p class="line">
          &gt; find them. type them. open the vault.<span
            class="cursor"
            aria-hidden="true">_</span
          >
        </p>

        <div class="vault">
          <div class="inside">
            <p class="granted">ACCESS GRANTED</p>
            <p>&gt; you cracked the code, hacker.</p>
            <a class="prize" href="http://youtu.be/oHg5SJYRHA0">
              claim your prize →
            </a>
          </div>

          <div class="door">
            <div class="wheel" aria-hidden="true"></div>
            <Code />
          </div>
        </div>

        <p class="status" role="status"></p>
      </div>
    </div>
  </section>

  <canvas class="confetti" aria-hidden="true"></canvas>
</Base>

<style>
  .terminal {
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    --glow: var(--color-primary);
    --error: #ff4d6d;
    max-width: 44rem;
    margin-inline: auto;
    text-align: left;
    font-family: var(--mono);
    color: var(--glow);
    background-color: var(--color-black);
    border: solid 2px var(--color-black);
    border-bottom-width: 8px;
    border-radius: var(--br-s);
    overflow: hidden;
    box-shadow: 0 0 3rem color-mix(in srgb, var(--glow) 25%, transparent);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1rem;
    background-color: #2a2c38;
    color: var(--color-grey);
    font-size: var(--fs--1);

    & span {
      width: 0.75rem;
      aspect-ratio: 1;
      border-radius: 50%;
      background-color: #ff5f57;
    }

    & span:nth-child(2) {
      background-color: #febc2e;
    }

    & span:nth-child(3) {
      background-color: var(--glow);
    }

    & p {
      margin: 0 auto;
      padding-right: 2.5rem;
    }
  }

  .screen {
    position: relative;
    padding: var(--sp-m) var(--sp-s-l) var(--sp-l);
    overflow: hidden;
    animation: flicker 6s infinite;
  }

  /* CRT scanlines */
  .screen::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 2px,
      rgb(0 0 0 / 0.3) 2px 4px
    );
    z-index: 2;
  }

  .line {
    margin-bottom: var(--sp-2xs);
    text-shadow: 0 0 0.4em color-mix(in srgb, var(--glow) 60%, transparent);
  }

  .cursor {
    animation: blink 1s steps(1) infinite;
  }

  /* ---------- vault ---------- */

  .vault {
    display: grid;
    margin-top: var(--sp-l);
    perspective: 1600px;
  }

  .inside,
  .door {
    grid-area: 1 / 1;
  }

  .door {
    position: relative;
    z-index: 1;
    padding: var(--sp-m) var(--sp-s-m);
    background: linear-gradient(145deg, #2f3240, #14151d);
    border: solid 2px #3d4052;
    border-radius: var(--br-s);
    box-shadow:
      inset 0 0 0 6px #191a23,
      inset 0 0 0 8px #3d4052;
    transform-origin: left center;
    transition:
      transform 1.2s cubic-bezier(0.6, 0, 0.2, 1) 0.6s,
      visibility 0s 1.8s;
  }

  .wheel {
    width: 3.5rem;
    aspect-ratio: 1;
    margin: 0 auto var(--sp-m);
    border: solid 3px var(--glow);
    border-radius: 50%;
    background: repeating-conic-gradient(
      var(--glow) 0 8deg,
      transparent 8deg 60deg
    );
    mask: radial-gradient(circle, #000 25%, transparent 26%, transparent 34%, #000 35%);
    filter: drop-shadow(0 0 0.4rem var(--glow));
    transition: rotate 0.6s ease-in-out;
  }

  .inside {
    display: grid;
    place-content: center;
    gap: var(--sp-2xs);
    padding: var(--sp-l) var(--sp-s);
    text-align: center;
    border: dashed 2px color-mix(in srgb, var(--glow) 40%, transparent);
    border-radius: var(--br-s);
    background:
      radial-gradient(
        circle,
        color-mix(in srgb, var(--glow) 25%, transparent),
        transparent 70%
      ),
      #0b0c12;
    visibility: hidden;
    opacity: 0;

    & p {
      margin: 0 auto;
    }
  }

  .granted {
    font-size: clamp(1.8rem, 1rem + 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.1;
    text-shadow:
      0 0 0.1em var(--glow),
      0 0 0.4em var(--glow),
      0 0 1em var(--glow);
  }

  .prize {
    justify-self: center;
    margin-top: var(--sp-s);
    padding: 0.6em 1.2em;
    color: var(--color-black);
    background-color: var(--glow);
    border-radius: var(--br-s);
    font-weight: 700;
    text-decoration: none;
  }

  .prize:is(:hover, :focus-visible) {
    outline: none;
    box-shadow: 0 0 1.5rem var(--glow);
  }

  /* open */
  .vault.open {
    & .wheel {
      rotate: 540deg;
    }

    & .door {
      transform: rotateY(-115deg);
      visibility: hidden;
      pointer-events: none;
    }

    & .inside {
      visibility: visible;
      opacity: 1;
      transition: opacity 0.8s ease 1s;
    }

    & .granted {
      animation: glitch-in 0.8s steps(8) 1s both;
    }
  }

  /* denied */
  .vault.denied .door {
    border-color: var(--error);
    animation:
      shake 0.5s ease,
      rgb-split 0.5s steps(3);
  }

  .status {
    position: relative;
    min-height: 1.5em;
    margin: var(--sp-s) 0 0;
  }

  .status.error {
    color: var(--error);
    animation: rgb-split 0.6s steps(3);
  }

  /* ---------- confetti ---------- */

  .confetti {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 100;
  }

  /* ---------- keyframes ---------- */

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes flicker {
    0%,
    96%,
    100% {
      opacity: 1;
    }
    97% {
      opacity: 0.85;
    }
    98% {
      opacity: 1;
    }
    99% {
      opacity: 0.9;
    }
  }

  @keyframes shake {
    0%,
    100% {
      translate: 0;
    }
    15% {
      translate: -10px 0;
    }
    30% {
      translate: 9px 2px;
    }
    45% {
      translate: -7px -2px;
    }
    60% {
      translate: 5px 0;
    }
    75% {
      translate: -3px 0;
    }
  }

  @keyframes rgb-split {
    0%,
    100% {
      filter: none;
      clip-path: none;
    }
    25% {
      filter: drop-shadow(-4px 0 #ff2a6d) drop-shadow(4px 0 #05d9e8);
      clip-path: inset(10% 0 45% 0);
    }
    50% {
      filter: drop-shadow(3px 0 #ff2a6d) drop-shadow(-3px 0 #05d9e8)
        hue-rotate(90deg);
      clip-path: inset(40% 0 5% 0);
    }
    75% {
      filter: drop-shadow(-2px 0 #ff2a6d) drop-shadow(2px 0 #05d9e8);
      clip-path: none;
    }
  }

  @keyframes glitch-in {
    0% {
      opacity: 0;
      translate: -0.3em 0;
      clip-path: inset(0 0 80% 0);
    }
    25% {
      opacity: 1;
      translate: 0.2em 0;
      clip-path: inset(50% 0 10% 0);
    }
    50% {
      translate: -0.1em 0;
      clip-path: inset(20% 0 40% 0);
    }
    75% {
      translate: 0.05em 0;
      clip-path: none;
    }
    100% {
      translate: 0;
      clip-path: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .screen,
    .cursor,
    .vault.denied .door,
    .status.error,
    .vault.open .granted {
      animation: none;
    }

    .door,
    .wheel,
    .vault.open .inside {
      transition: none;
    }

    .vault.open .door {
      transform: none;
    }
  }
</style>

<script>
  const vault = document.querySelector<HTMLElement>(".vault")!;
  const form = vault.querySelector("form")!;
  const inputs = [...form.querySelectorAll("input")];
  const status = document.querySelector<HTMLElement>(".status")!;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // one digit per box, jump to the next/previous box automatically
  inputs.forEach((input, i) => {
    input.addEventListener("input", () => {
      input.value = input.value.replace(/\D/g, "").slice(-1);
      if (input.value) inputs[i + 1]?.focus();
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "Backspace" && !input.value) inputs[i - 1]?.focus();
    });
  });

  // pasting "1234" fills all boxes
  form.addEventListener("paste", (e) => {
    const digits = (e.clipboardData?.getData("text") ?? "")
      .replace(/\D/g, "")
      .slice(0, inputs.length);
    if (!digits) return;
    e.preventDefault();
    [...digits].forEach((digit, i) => (inputs[i].value = digit));
    inputs[digits.length - 1].focus();
  });

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    if (form.checkValidity()) unlock();
    else deny();
  });

  function deny() {
    status.textContent = "> ACCESS DENIED. try again.";
    // restart the glitch animations
    vault.classList.remove("denied");
    status.classList.remove("error");
    void vault.offsetWidth;
    vault.classList.add("denied");
    status.classList.add("error");
    inputs.forEach((input) => (input.value = ""));
    inputs[0].focus();
  }

  function unlock() {
    status.classList.remove("error");
    status.textContent = "> vault unlocked.";
    vault.classList.remove("denied");
    vault.classList.add("open");
    form.querySelectorAll("input, button").forEach((el) => {
      (el as HTMLInputElement).disabled = true;
    });

    const prize = vault.querySelector<HTMLElement>(".prize")!;
    if (reduceMotion.matches) {
      prize.focus({ preventScroll: true });
      return;
    }
    setTimeout(() => prize.focus({ preventScroll: true }), 1800);
    setTimeout(confetti, 900);
  }

  // code-flavoured confetti: { } ; </> and green paper bits
  function confetti() {
    const canvas = document.querySelector<HTMLCanvasElement>(".confetti")!;
    const ctx = canvas.getContext("2d")!;
    const dpr = window.devicePixelRatio || 1;
    const w = window.innerWidth;
    const h = window.innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const css = getComputedStyle(document.documentElement);
    const colors = ["--color-primary", "--color-white", "--color-grey"].map(
      (name) => css.getPropertyValue(name).trim(),
    );
    const glyphs = ["{", "}", ";", "</>", "//", "0", "1", "()", "=>"];
    const rect = vault.getBoundingClientRect();
    const random = (min: number, max: number) =>
      min + Math.random() * (max - min);

    const parts = Array.from({ length: 180 }, () => ({
      x: rect.left + rect.width / 2,
      y: rect.top + rect.height / 2,
      vx: random(-14, 14),
      vy: random(-20, -6),
      rot: random(0, Math.PI * 2),
      vr: random(-0.25, 0.25),
      size: random(12, 26),
      color: colors[Math.floor(Math.random() * colors.length)],
      glyph:
        Math.random() < 0.55
          ? glyphs[Math.floor(Math.random() * glyphs.length)]
          : null,
    }));

    const duration = 4500;
    const start = performance.now();

    function frame(now: number) {
      const t = now - start;
      ctx.clearRect(0, 0, w, h);
      ctx.globalAlpha = Math.max(0, 1 - t / duration);

      for (const p of parts) {
        p.vy += 0.4;
        p.vx *= 0.985;
        p.x += p.vx;
        p.y += p.vy;
        p.rot += p.vr;

        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.rot);
        ctx.fillStyle = p.color;
        ctx.shadowColor = p.color;
        ctx.shadowBlur = 8;
        if (p.glyph) {
          ctx.font = `700 ${p.size}px ui-monospace, Menlo, monospace`;
          ctx.textAlign = "center";
          ctx.fillText(p.glyph, 0, 0);
        } else {
          ctx.fillRect(-p.size / 4, -p.size / 8, p.size / 2, p.size / 4);
        }
        ctx.restore();
      }

      if (t < duration) requestAnimationFrame(frame);
      else ctx.clearRect(0, 0, w, h);
    }

    requestAnimationFrame(frame);
  }
</script>
