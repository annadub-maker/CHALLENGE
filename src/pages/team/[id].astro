---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const team = await getCollection("team");
  return team.map((member) => ({
    params: { id: member.id },
    props: { member },
  }));
}

const { member } = Astro.props;
const { name, function: role, bio, pic } = member.data;
const { Content } = await render(member);
const firstName = name.split(" ")[0].toLowerCase();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base title={name}>
  <svg
    viewBox="0 0 98 99"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    width="0"
    height="0"
    aria-hidden="true"
  >
    <defs>
      <clipPath
        id="petals"
        clipPathUnits="objectBoundingBox"
        transform="scale(0.01, 0.01)"
      >
        <path
          d="M83.8068 49.7349C116.649 87.1445 86.3213 117.472 48.9117 84.63C11.5021 117.472 -18.8258 87.1445 14.0166 49.7349C-18.8258 12.3253 11.5021 -18.0026 48.9117 14.8398C86.3213 -18.0026 116.649 12.3253 83.8068 49.7349Z"
        ></path>
      </clipPath>
    </defs>
  </svg>

  <article class="container profile">
    <a class="back" href={`${base}/#team`}>cd ../team</a>

    <div class="intro">
      <div class="portrait">
        <div class="pattern" aria-hidden="true"></div>
        <div class="petal">
          <Image src={pic} width={600} height={600} alt={`Portrait of ${name}`} />
        </div>
      </div>

      <div class="text">
        <p class="function">{role}</p>
        <h1><span>{name}</span></h1>
        <p class="bio">
          <span class="brace" aria-hidden="true">{"{"}</span>
          {bio}
          <span class="brace" aria-hidden="true">{"}"}</span>
        </p>
      </div>
    </div>

    <p class="label" aria-hidden="true">/* about.{firstName} */</p>
    <div class="md content">
      <Content />
    </div>
  </article>
</Base>

<style>
  .profile {
    --mono: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    text-align: left;
  }

  .back {
    display: inline-block;
    font-family: var(--mono);
    color: var(--color-text);
    text-decoration: none;
    border: solid 2px var(--color-text);
    border-radius: var(--br-s);
    padding: var(--sp-3xs) var(--sp-xs);
    margin-bottom: var(--sp-l);
    transition: background-color 0.2s ease;
  }

  .back::before {
    content: "$ ";
    opacity: 0.5;
  }

  .back:hover {
    background-color: var(--color-primary);
  }

  .intro {
    display: grid;
    gap: var(--sp-xl);
    align-items: center;
    margin-bottom: var(--sp-2xl);
  }

  .portrait {
    position: relative;
    width: min(100%, 26rem);
    margin-inline: auto;
  }

  /* generative-ish dot grid behind the portrait */
  .pattern {
    position: absolute;
    inset: 8% -6% -6% 8%;
    border: solid 2px var(--color-text);
    border-radius: var(--br-l);
    background-color: var(--color-primary);
    background-image: radial-gradient(
      var(--color-black) 15%,
      transparent 17%
    );
    background-size: 1.1rem 1.1rem;
    rotate: -6deg;
  }

  .petal {
    position: relative;
    clip-path: url(#petals);
    transition: rotate 0.8s ease;
  }

  .petal::after {
    content: "";
    position: absolute;
    inset: 0;
    background-color: var(--color-primary);
    mix-blend-mode: multiply;
  }

  .petal img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    filter: grayscale(100%) brightness(110%);
    transition: rotate 0.8s ease;
  }

  .portrait:hover {
    & .petal {
      rotate: 90deg;
    }

    & img {
      rotate: -90deg;
    }
  }

  .function {
    font-family: var(--mono);
    font-size: var(--fs-0);
    margin-bottom: var(--sp-s);
  }

  .function::before {
    content: "// ";
    background-color: var(--color-primary);
    border-radius: 0.2em;
    padding: 0 0.2em;
    margin-right: 0.3em;
  }

  h1 {
    font-size: clamp(2.5rem, 1.5rem + 5vw, 5.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-m);
  }

  .bio {
    font-size: var(--fs-2);
    line-height: 1.3;
  }

  .brace {
    font-family: var(--mono);
    font-weight: 700;
    color: var(--color-black);
    background-color: var(--color-primary);
    border-radius: 0.2em;
    padding: 0 0.15em;
  }

  .label {
    font-family: var(--mono);
    font-size: var(--fs--1);
    opacity: 0.6;
    border-top: dashed 1px var(--color-text);
    padding-top: var(--sp-m);
    margin-bottom: var(--sp-s);
  }

  .content {
    max-width: 70ch;
  }

  @media (min-width: 45em) {
    .intro {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back,
    .petal,
    .petal img {
      transition: none;
    }

    .portrait:hover {
      & .petal,
      & img {
        rotate: none;
      }
    }
  }
</style>
